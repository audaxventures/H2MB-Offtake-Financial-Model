# Copy to .env, fill in real values, and never commit the copy (.env is
# already gitignored). In Vercel, set these under Project Settings > Environment
# Variables instead — Vercel's Neon integration can fill in DATABASE_URL for you.

# Neon connection string (Neon dashboard > your project > Connection Details).
# Use the "pooled connection" string.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Used only by scripts/create-user.mjs to create/update your login.
NEW_USER_EMAIL=
NEW_USER_PASSWORD=
