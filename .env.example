# Copy to .env for local testing, fill in real values, and never commit the
# copy (.env is already gitignored). In Vercel, set these under Project
# Settings > Environment Variables instead.

# Neon connection string (Neon dashboard > your project > Connection Details).
# Use the "pooled connection" string.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Your login for this app. There's only one account, so this *is* the
# credential store — no database users table involved.
AUTH_EMAIL=you@example.com
AUTH_PASSWORD=choose-a-strong-password
